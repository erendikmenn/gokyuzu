# Gökyüzü deploy configuration: TEMPLATE with placeholders (this copy is committed; the filled-in one never is).
#
#   mkdir -p ~/.config/gokyuzu && cp tools/deploy/deploy.env.example ~/.config/gokyuzu/deploy.env
#   chmod 600 ~/.config/gokyuzu/deploy.env      # then replace every REPLACE_ME and example.com value
#   tools/deploy/deploy.sh --check-config        # checks the keys (prints names only, never values; no AWS calls)
#
# Another location: export GOKYUZU_DEPLOY_ENV=/path/to/deploy.env
#
# Read by tools/deploy/{deploy.sh,staging_access.sh,rollback.py}, tools/analytics/{setup,report}.py and
# infra/leaderboard/{setup.py,verify.mjs}, through the loaders tools/deploy/config.sh, deploy_config.py and config.mjs
# (identical rules):
#   * one KEY=VALUE per line; lines starting with # are comments (no comment after a value); optional "quotes";
#     no $variable expansion; an optional leading `export ` is allowed, so the file can also be sourced by a shell;
#   * values come from this file only: a shell variable of the same name never overrides them (a stray AWS_REGION or
#     AWS_ACCOUNT_ID in your shell cannot redirect a deploy). Exception: the three AWS_PROFILE_* names below, which an
#     environment variable of the same name still overrides;
#   * a key that a script needs but that is missing, empty or still REPLACE_ME stops the script before any AWS call,
#     with an error naming the key.
# None of these values are secrets (credentials live in ~/.aws and ~/.config/cloudflare.env), but they identify the
# owner's infrastructure, so they stay out of the repository.

# AWS account that hosts the site (12 digits). infra/leaderboard/setup.py refuses to run against any other account.
AWS_ACCOUNT_ID=REPLACE_ME
# Region of the S3 buckets and of the leaderboard stack (CloudFront itself is global).
AWS_REGION=eu-central-1

# S3 bucket names, without s3:// (the site of each target, and the bucket that receives the CloudFront access logs).
S3_BUCKET_PRODUCTION=REPLACE_ME
S3_BUCKET_STAGING=REPLACE_ME
S3_BUCKET_LOGS=REPLACE_ME

# CloudFront distribution ids (E followed by 12-13 letters and digits).
CF_DIST_PRODUCTION=REPLACE_ME
CF_DIST_STAGING=REPLACE_ME
# Optional: each distribution's own host name (dXXXXXXXXXXXXX.cloudfront.net), for checks that bypass the Cloudflare
# proxy, e.g. `node infra/leaderboard/verify.mjs production --cf`.
CF_HOST_PRODUCTION=
CF_HOST_STAGING=

# Public site URLs (https://…, no trailing slash). Production's host name is also the host whose Cloudflare cache a
# production deploy purges.
SITE_PRODUCTION=https://fs.example.com
SITE_STAGING=https://staging.fs.example.com

# Cloudflare zone id (32 hex characters) of the production host; production deploys purge its cache. The API token is
# not kept here: deploy.sh reads CLOUDFLARE_API_TOKEN from ~/.config/cloudflare.env.
CLOUDFLARE_ZONE_ID=REPLACE_ME

# ~/.aws profiles, always passed explicitly (the shell's AWS_PROFILE is ignored on purpose: it may point at another
# account). The values below are the built-in defaults.
# Deploys, rollbacks and Lambda code updates (least-privilege IAM user gokyuzu-deployer).
AWS_PROFILE_DEPLOY=gokyuzu-deploy
# One-time infrastructure setup: tools/analytics/setup.py, infra/leaderboard/setup.py, verify.mjs (--cold, direct URL).
AWS_PROFILE_ADMIN=gokyuzu-admin
# Read-only access to the log bucket: tools/analytics/report.py.
AWS_PROFILE_ANALYTICS=gokyuzu-analytics
